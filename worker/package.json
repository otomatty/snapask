{
  "name": "snapask-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply snapask --local",
    "db:migrate:remote": "wrangler d1 migrations apply snapask --remote",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
